# Copy to .env and fill in what you need. Every setting is optional for local use.
# The app reads plain environment variables; load this file with:
#   set -a; source .env; set +a
# On Fly.io, put secrets in `fly secrets set` and the rest in fly.toml [env].

# --- Games (Lichess) ---
# Comma-separated Lichess Study IDs holding your games. Required unless DEMO_MODE=1.
LICHESS_STUDY_IDS=abcdWXYZ
# Only needed if a Study is private. Secret.
LICHESS_API_TOKEN=
# Your name as it appears in the PGN headers. Blank = auto-detect.
PLAYER_NAME=

# --- Enrichment (all optional) ---
# USCF member ID whose official record enriches the games. Blank = Lichess only.
USCF_MEMBER_ID=
# Anthropic key for the plain-English game summaries. Blank = no summaries. Secret.
ANTHROPIC_API_KEY=

# --- Login (single-user owner/guest) ---
# Hash of the owner's password. Mint one with: python -m user_config hash
# Keep the single quotes: the hash contains `$`. Blank = no login, anyone can Sync.
OWNER_PASSWORD_HASH=''
# Signs the session cookie. Required when a login is on. Secret. Generate with:
#   python -c 'import secrets; print(secrets.token_hex(32))'
SECRET_KEY=

# --- Login (multi-user, instead of the owner login) ---
# JSON array of user records; see user_config.py. Blank = single-user. Secret.
USCF_DASHBOARD_USERS=
# Where each user's caches live, one subdirectory per user.
DATA_DIR=.user-data

# --- Demo mode ---
# 1 = boot from the committed anonymized games, no network calls, read-only.
DEMO_MODE=
DEMO_CACHE_PATH=tests/data/demo-games.pgn

# --- Caches (disposable; safe to delete) ---
CACHE_PATH=games.pgn
USCF_CACHE_PATH=uscf_cache.json
ANALYSIS_CACHE_PATH=analysis_cache.json

# --- Server ---
HOST=127.0.0.1
PORT=8050
DEBUG=
LOG_LEVEL=info
